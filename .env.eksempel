# Omdøb denne fil til .env og indsæt din nøgle.
# .env læses automatisk af scriptet og skal ALDRIG lægges i et git-repo.

# Brevo (samme tjeneste som klimamonitoren bruger til daglig digest).
# Nøglen findes i Brevo under SMTP & API -> API Keys.
BREVO_API_KEY=

# Mailadresser står bevidst IKKE i config.json, fordi repoet er offentligt.
# Flere modtagere adskilles med komma.
TEATERMONITOR_MODTAGERE=
TEATERMONITOR_AFSENDER=

# Kun nødvendig hvis du sætter "afsendelse": "smtp" i config.json
TEATERMONITOR_SMTP_KODE=
